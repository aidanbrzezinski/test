# KiBot configuration file for KDT_Hierarchical Template
# KiCad 10

kibot:
  version: 1

variants:

  # Project variants
  # These control which components are shown/hidden (DNP) in the 3D render
  # and STEP export. They also gate which of ERC/DRC are applicable yet --
  # see the CI workflow (.github/workflows/ci.yaml) and kibot_launch.sh for
  # that logic, and README.md's "PROJECT STAGES" section for the full plan.

  - name: 'DRAFT'
    comment: "Very early stage of schematic, ignore details."
    type: kibom
    variant: DRAFT
    exclude_filter: '_null'

  - name: 'PRELIMINARY'
    comment: "Close to final schematic."
    type: kibom
    variant: PRELIMINARY
    exclude_filter: '_null'

  - name: 'CHECKED'
    comment: "There shouldn't be any mistakes. Contact the engineer if you find any."
    type: kibom
    variant: CHECKED
    exclude_filter: '_null'

  - name: 'RELEASED'
    comment: "A board with this schematic has been sent to production."
    type: kibom
    variant: RELEASED
    exclude_filter: '_null'

groups:

  - name: all_group
    outputs:
      - 3d
      - 3d_render
      - md_readme

  - name: 3d_render
    outputs:
      - png_3d_viewer_top
      - png_3d_viewer_bottom
      - png_3d_viewer_angled_top
      - png_3d_viewer_angled_bottom

  - name: 3d
    outputs:
      - step

import:

  # Global parameters ==========================================================

  - file: kibot_globals.yaml
    definitions:
      OUTPUT_DIR: ./
      LAYER_DNP_TOP: F.DNP
      LAYER_DNP_BOTTOM: B.DNP

  # Preflights =================================================================

  # Generate ERC Report. Fails the pipeline if errors are found.
  - file: kibot_pre_erc_report.yaml
    definitions:
      DIR: Reports

  # Generate DRC Report. Fails the pipeline if errors are found.
  - file: kibot_pre_drc_report.yaml
    definitions:
      CHECK_ZONE_FILLS: false
      DIR: Reports

# Generated outputs ============================================================

  # PNG 3D Viewer renders ------------------------------------------------------
  # All four renders are exported as standalone PNG files in Images/, and the
  # top/bottom pair is embedded in the generated README.md. The .kicad_sch
  # cover page's kibot_image_png_3d_viewer_top/bottom placeholders are NOT
  # filled in by KiBot itself (that mechanism only pastes into a schematic
  # print/export output, which this template doesn't generate) -- instead,
  # the CI workflow runs kibot_resources/scripts/embed_render_images.py right
  # after this output to permanently embed the top/bottom renders. See
  # README.md ("Adding the PCB Render to the Schematic Cover Page").
  - file: kibot_out_png_3d_viewer.yaml
    definitions:
      NAME: png_3d_viewer_top
      COMMENT: Top 3D viewer PCB render in PNG format
      DIR: Images
      SUFFIX: top
      VIEW: top
      KEY_COLOR: '#00FF00'

  - file: kibot_out_png_3d_viewer.yaml
    definitions:
      NAME: png_3d_viewer_bottom
      COMMENT: Bottom 3D viewer PCB render in PNG format
      DIR: Images
      SUFFIX: bottom
      VIEW: bottom
      KEY_COLOR: '#00FF00'

  - file: kibot_out_png_3d_viewer.yaml
    definitions:
      NAME: png_3d_viewer_angled_top
      COMMENT: Top (angled) 3D viewer PCB render in PNG format
      DIR: Images
      SUFFIX: angled_top
      VIEW: top
      ROTATE_X: 2
      ROTATE_Y: -1
      ROTATE_Z: 1
      ZOOM: -1
      KEY_COLOR: '#00FF00'

  - file: kibot_out_png_3d_viewer.yaml
    definitions:
      NAME: png_3d_viewer_angled_bottom
      COMMENT: Bottom (angled) 3D viewer PCB render in PNG format
      DIR: Images
      SUFFIX: angled_bottom
      VIEW: bottom
      ROTATE_X: 2
      ROTATE_Y: -1
      ROTATE_Z: -1
      ZOOM: -1
      KEY_COLOR: '#00FF00'

  # STEP file ------------------------------------------------------------------
  - file: kibot_out_step.yaml
    definitions:
      NAME: step
      COMMENT: PCB 3D model in STEP format
      DIR: 3D

  # README.md file generation --------------------------------------------------
  - file: kibot_out_md_report.yaml
    definitions:
      NAME: md_readme
      COMMENT: README file in Markdown format
      DIR: ./
      CATEGORY: '.'
      OUTPUT_NAME: README
      TEMPLATE: kibot_resources/templates/readme.txt

